# Copy this file to `.env` and adjust as needed.
#
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app bundle.
# Never put secrets here — these values are embedded in the client.

# Campus backend (issues, lost & found, auth). Defaults to the hosted Render
# service. Override with a localhost / ngrok URL for local development.
# A tunnel URL is ignored in release builds/OTA updates unless you also set
# EXPO_PUBLIC_ALLOW_TUNNEL=true (deliberate opt-in). Such a build only works
# while this machine and ngrok are running.
EXPO_PUBLIC_API_URL=https://jec-backend.onrender.com
EXPO_PUBLIC_ALLOW_TUNNEL=false

# Official JEC attendance portal (read-only student reports).
EXPO_PUBLIC_ATTENDANCE_API_URL=https://attendance.jecassam.ac.in

# GitHub raw bucket with timetable / syllabus / library / announcements JSON.
EXPO_PUBLIC_CONTENT_BASE_URL=https://raw.githubusercontent.com/souvikdas1757/jec-app-data/refs/heads/main
