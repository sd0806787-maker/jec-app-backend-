{
  "expo": {
    "name": "JEC Student",
    "slug": "MyAppClean",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0A0A0A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.souvik1172.JECStudent"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "a0864391-f7f3-4c43-b118-c1e50e88840d"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JEC Student to access your photos to attach images to campus reports.",
          "microphonePermission": false
        }
      ]
    ],
    "owner": "souvik1172",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a0864391-f7f3-4c43-b118-c1e50e88840d"
    }
  }
}