# Copy this file to `.env` and fill in real values.
# NEVER commit the resulting `.env` file.

PORT=3000

# MongoDB connection string (local or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/jec_student_db

# Secret used to sign auth JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

# Gmail account used by the medical-leave mailer.
# For Gmail, EMAIL_PASS must be a 16-character App Password, not the account password.
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# Maximum request body size (base64 images are large).
BODY_LIMIT=25mb
